# Copy this file to .env for LOCAL DEVELOPMENT ONLY
# NEVER commit .env — it is gitignored
#
# Production portal uses standard ServiceNow session cookies — no credentials needed.

# ── Local dev: Vite proxy auth ─────────────────────────────────────────────────
# Used by src/api/servicenow.ts in development mode only.
# These values are NOT embedded in the production build.
VITE_SN_USER=your.username
VITE_SN_PASS=your_password_here

# ── Deploy script ──────────────────────────────────────────────────────────────
# Used by scripts/deploy.mjs (CI/CD or local manual deploy).
# Set these as GitHub Secrets for automated deploys.
SN_INSTANCE=https://dev204322.service-now.com
SN_USER=integration.ide
SN_PASS=your_password_here
SN_PROPERTY_NAME=x_1512879_applic_0.cmdb_portal.html
