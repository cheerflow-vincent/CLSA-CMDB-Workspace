# Copy this file to .env for local tooling only.
# NEVER commit .env — it is gitignored.
#
# The portal UI runs on ServiceNow and uses session cookies (g_ck).
# These variables are for deploy scripts on your machine, not for end users.

# ── ServiceNow SDK (recommended: npm run deploy) ─────────────────────────────
# Used by `npx now-sdk install` when not using interactive `now-sdk auth`.
# Prefer `npm run auth` / `now-sdk auth` so credentials stay in .now-sdk/ locally.
SN_SDK_INSTANCE_URL=https://YOUR_INSTANCE.service-now.com
SN_SDK_USER=your.integration.user
SN_SDK_USER_PWD=your_password_here

# ── Optional: scripts/deploy-direct.mjs (Table API patch deploy) ─────────────
SN_INSTANCE=https://YOUR_INSTANCE.service-now.com
SN_USER=your.integration.user
SN_PASS=your_password_here
